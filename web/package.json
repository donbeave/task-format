{
  "name": "task-monitor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun --bun vitest run",
    "lint": "bun --bun biome check src vite.config.ts vitest.config.ts",
    "format": "bun --bun biome format --write src vite.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.2.8",
    "@tanstack/react-router": "1.170.33",
    "@tanstack/react-start": "1.168.50",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.24.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/bun": "1.4.1",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
