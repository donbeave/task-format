# verify.config — project-specific inputs for verify.sh. Sourced by bash; data only.
# Paths are relative to the repository root (VERIFY_ROOT).

BASE_REF="baseline"                 # commit/tag/branch the task started from; scope diff base

# Commands run from the repo root. Each must exit 0.
FOCUSED_CMDS=("<focused test command for AC-001>" "<focused test command for AC-002>")
REGRESSION_CMDS=("<relevant regression suite>")
LINT_CMDS=("<fmt --check>" "<lint>")

# "ERE @@ path1 path2" — regex must NOT match in the given paths (default: whole tree). Regex may contain '|'.
FORBIDDEN_PATTERNS=('<legacy_symbol> @@ src tests' '#\[ignore\] @@ tests' 'TODO\(TASK-000\)')
FORBIDDEN_PATHS=("<src/legacy/file>")      # must not exist after the task
REQUIRED_PATHS=("<tests/new_test_file>")   # must exist after the task

# Scope whitelist: every changed file (vs BASE_REF, plus staged and untracked) must match one
# ALLOWED glob; anything else fails the gate. Bash [[ == ]] globs; '*' and '**' cross '/'.
ALLOWED_GLOBS=("src/<area>/*" "tests/<area>/*")

# Optional user-defined checks: define check_<name>() here and list the names.
EXTRA_CHECKS=()
