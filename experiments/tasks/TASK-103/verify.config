# TASK-103 verify.config — sourced by verify.sh; data + check_* functions only.
# pg_* tests need Docker (testcontainers, postgres:16-alpine); P-004 guards this.
BASE_REF="baseline"

FOCUSED_CMDS=(
  "cargo test -p pgtui --test pg_connect_test"
  "cargo test -p pgtui --test app_browser_test"
  "cargo test -p pgtui --test pg_runtime_connect_test"
  "INSTA_UPDATE=no INSTA_FORCE_PASS=0 cargo test -p pgtui --test screen_browser_test"
)
# Explicit target list: TASK-101..103 trusted tests; later files do not compile yet.
REGRESSION_CMDS=(
  "INSTA_UPDATE=no INSTA_FORCE_PASS=0 cargo test -p pgtui --lib --bins --test store_test --test screen_connection_list_test --test app_connection_list_test --test cli_test --test app_create_form_test --test runtime_create_test --test screen_create_form_test --test pg_connect_test --test app_browser_test --test pg_runtime_connect_test --test screen_browser_test"
)
LINT_CMDS=("cargo fmt --all --check" "cargo clippy --workspace --all-targets -- -D warnings")

# "ERE @@ path1 path2" — regex must NOT match in the given paths (default: whole tree). Regex may contain '|'.
FORBIDDEN_PATTERNS=(
  '#\[ignore\] @@ crates/pgtui'
  'todo!\( @@ crates/pgtui/src'
  'unimplemented!\( @@ crates/pgtui/src'
  'dbg!\( @@ crates/pgtui/src'
  'allow\((clippy|dead_code|unused) @@ crates/pgtui/src'
  'INSTA_ @@ crates/pgtui/src'
  '\.snap\.new @@ crates/pgtui/src'
  'TODO\(TASK-103\)'
  'sslmode @@ crates/pgtui/src'
  'query_raw\( @@ crates/pgtui/src/db'
  'query_one\( @@ crates/pgtui/src/db'
  'query_opt\( @@ crates/pgtui/src/db'
  '\.query\( @@ crates/pgtui/src/db'
  '\.prepare\( @@ crates/pgtui/src/db'
  '\.execute\( @@ crates/pgtui/src/db'
  'load_system_fonts @@ crates/pgtui/src'
)
FORBIDDEN_PATHS=()
REQUIRED_PATHS=(
  "crates/pgtui/src/db/mod.rs"
  "crates/pgtui/src/db/postgres.rs"
  "crates/pgtui/src/ui/browser.rs"
)

ALLOWED_GLOBS=(
  "crates/pgtui/src/db/*" "crates/pgtui/src/app.rs" "crates/pgtui/src/keys.rs" "crates/pgtui/src/runtime.rs"
  "crates/pgtui/src/ui/browser.rs" "crates/pgtui/src/ui/mod.rs" "crates/pgtui/src/lib.rs"
)

EXTRA_CHECKS=("no_snap_new" "simple_query_used" "no_leaked_containers")
check_no_snap_new() {
  local hit; hit="$(find crates -name '*.snap.new' -print -quit)"
  [[ -z "$hit" ]] || { echo "pending snapshot: $hit"; return 1; }
  echo "ok no *.snap.new"
}
# D-023: the only statement path in db/postgres.rs is Client::simple_query.
check_simple_query_used() {
  grep -q 'simple_query' crates/pgtui/src/db/postgres.rs || { echo "simple_query not used in db/postgres.rs"; return 1; }
  grep -q 'NoTls' crates/pgtui/src/db/postgres.rs || { echo "NoTls not used in db/postgres.rs"; return 1; }
  echo "ok simple_query + NoTls present"
}
# testcontainers-rs has no Ryuk reaper; containers leak only if a test process was SIGKILLed.
check_no_leaked_containers() {
  local ids; ids="$(docker ps -q --filter ancestor=postgres:16-alpine)"
  [[ -z "$ids" ]] || { echo "leaked postgres containers: $ids"; return 1; }
  echo "ok no leaked postgres:16-alpine containers"
}
