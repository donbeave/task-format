# verify.config — TASK-104. Sourced by verify.sh; data only. Paths relative to the repo root.

BASE_REF="baseline"

# Focused: one per trusted test file (--test <file> so one compile failure cannot mask another).
FOCUSED_CMDS=(
  "cargo test -p pgtui --test grid_sort_test"
  "cargo test -p pgtui --test pg_preview_test"
  "cargo test -p pgtui --test app_preview_test"
  "INSTA_UPDATE=no INSTA_FORCE_PASS=0 cargo test -p pgtui --test screen_preview_test"
)
# Regression: explicit list of test targets that exist up to TASK-104 (later files do not compile yet).
REGRESSION_CMDS=(
  "INSTA_UPDATE=no INSTA_FORCE_PASS=0 cargo test -p pgtui --lib --test store_test --test screen_connection_list_test --test app_connection_list_test --test cli_test --test app_create_form_test --test runtime_create_test --test screen_create_form_test --test pg_connect_test --test app_browser_test --test pg_runtime_connect_test --test screen_browser_test --test grid_sort_test --test pg_preview_test --test app_preview_test --test screen_preview_test"
)
LINT_CMDS=("cargo fmt --all --check" "cargo clippy --workspace --all-targets -- -D warnings")

# "ERE|path1 path2" — regex must NOT match in the given paths. The regex itself must not contain '|'.
FORBIDDEN_PATTERNS=(
  '#\[ignore\] @@ crates/pgtui/tests crates/pgtui/src'
  'INSTA_ @@ crates/pgtui/src'
  '\.snap\.new @@ crates/pgtui/src .cargo'
  'todo!\( @@ crates/pgtui/src'
  'unimplemented!\( @@ crates/pgtui/src'
  'dbg!\( @@ crates/pgtui/src'
  'allow\((clippy|dead_code|unused) @@ crates/pgtui/src'
  'TODO\(TASK-104\)'
  'ORDER BY @@ crates/pgtui/src/app.rs crates/pgtui/src/grid.rs'
  'sort_unstable @@ crates/pgtui/src'
  'sslmode @@ crates/pgtui/src'
  'query_raw @@ crates/pgtui/src'
  'query_one @@ crates/pgtui/src'
)
FORBIDDEN_PATHS=()
REQUIRED_PATHS=("crates/pgtui/src/grid.rs" "crates/pgtui/src/ui/grid.rs" "crates/pgtui/src/db/mod.rs" "crates/pgtui/src/db/postgres.rs")

# Scope: every changed file (vs BASE_REF, plus staged and untracked) must match one ALLOWED glob and no DENIED glob.
ALLOWED_GLOBS=(
  "crates/pgtui/src/grid.rs"
  "crates/pgtui/src/db/*"
  "crates/pgtui/src/app.rs"
  "crates/pgtui/src/keys.rs"
  "crates/pgtui/src/runtime.rs"
  "crates/pgtui/src/ui/browser.rs"
  "crates/pgtui/src/ui/grid.rs"
  "crates/pgtui/src/ui/mod.rs"
  "crates/pgtui/src/lib.rs"
)
DENIED_GLOBS=(
  "Cargo.toml" "Cargo.lock" "crates/pgtui/Cargo.toml" "justfile" "rust-toolchain.toml"
  "crates/pgtui/tests/*" "*/tests/*" "tests/*"
  "crates/pgtui/src/store/*" "crates/pgtui/src/render.rs" "crates/pgtui/src/fonts/*"
  ".claude/*" "CLAUDE.md" "AGENTS.md"
)

# Optional user-defined checks.
EXTRA_CHECKS=("no_snap_new")
check_no_snap_new() { ! find crates -name '*.snap.new' -print | grep -q .; }
