# verify.config — TASK-106. Sourced by verify.sh; data only. Paths relative to the repo root.

BASE_REF="baseline"

# Focused: one per trusted test file (--test <file> so one compile failure cannot mask another).
FOCUSED_CMDS=(
  "cargo test -p pgtui --test app_disconnect_test"
  "cargo test -p pgtui --test pg_disconnect_test"
  "cargo test -p pgtui --test cli_exit_test"
  "cargo test -p pgtui --test gallery_test"
  "INSTA_UPDATE=no INSTA_FORCE_PASS=0 cargo test -p pgtui --test 'screen_*'"
)
# Regression: whole crate (every trusted test file compiles from this task on) + a real gallery run.
REGRESSION_CMDS=(
  "INSTA_UPDATE=no INSTA_FORCE_PASS=0 cargo test -p pgtui"
  "cargo run -p pgtui --bin gallery -- --out target/gallery-verify"
)
LINT_CMDS=("cargo fmt --all --check" "cargo clippy --workspace --all-targets -- -D warnings")

# "ERE @@ path1 path2" — regex must NOT match in the given paths (default: whole tree). Regex may contain '|'.
FORBIDDEN_PATTERNS=(
  '#\[ignore\] @@ crates/pgtui/tests crates/pgtui/src'
  'INSTA_ @@ crates/pgtui/src'
  '\.snap\.new @@ crates/pgtui/src .cargo'
  'todo!\( @@ crates/pgtui/src'
  'unimplemented!\( @@ crates/pgtui/src'
  'dbg!\( @@ crates/pgtui/src'
  'allow\((clippy|dead_code|unused) @@ crates/pgtui/src'
  'TODO\(TASK-106\)'
  'process::exit\( @@ crates/pgtui/src/app.rs crates/pgtui/src/runtime.rs crates/pgtui/src/db'
  'sort_unstable @@ crates/pgtui/src'
  'sslmode @@ crates/pgtui/src'
  'query_raw @@ crates/pgtui/src'
  'query_one @@ crates/pgtui/src'
  '#\[path @@ crates/pgtui/src/bin'
  'resvg @@ crates/pgtui/src/bin'
  'usvg @@ crates/pgtui/src/bin'
  'tiny_skia @@ crates/pgtui/src/bin'
  '<svg @@ crates/pgtui/src/bin'
)
FORBIDDEN_PATHS=()
REQUIRED_PATHS=(
  "crates/pgtui/src/bin/gallery.rs"
  "docs/screens/screen__connection_list_empty.svg"
  "docs/screens/screen__connection_list_empty.png"
  "docs/screens/screen__custom_sql_results.svg"
  "docs/screens/screen__custom_sql_results.png"
)

# Scope: every changed file (vs BASE_REF, plus staged and untracked) must match one ALLOWED glob and no DENIED glob.
ALLOWED_GLOBS=(
  "crates/pgtui/src/app.rs"
  "crates/pgtui/src/keys.rs"
  "crates/pgtui/src/runtime.rs"
  "crates/pgtui/src/main.rs"
  "crates/pgtui/src/db/postgres.rs"
  "crates/pgtui/src/bin/gallery.rs"
  "docs/screens/*"
  "README.md"
)
DENIED_GLOBS=(
  "Cargo.toml" "Cargo.lock" "crates/pgtui/Cargo.toml" "justfile" "rust-toolchain.toml"
  "crates/pgtui/tests/*" "*/tests/*" "tests/*"
  "crates/pgtui/src/store/*" "crates/pgtui/src/grid.rs" "crates/pgtui/src/render.rs" "crates/pgtui/src/fonts/*"
  ".claude/*" "CLAUDE.md" "AGENTS.md"
)

# User-defined checks (run after FOCUSED/REGRESSION, so target/gallery-verify exists).
EXTRA_CHECKS=("visual_pngs" "no_snap_new")

GALLERY_SCREENS=(
  screen__connection_list_empty screen__connection_list_two
  screen__create_form_blank screen__create_form_filled
  screen__browser_sidebar_empty_body
  screen__preview_unsorted screen__preview_sorted_asc screen__preview_sorted_desc
  screen__custom_sql_empty screen__custom_sql_results
)

# PNG IHDR width/height (bytes 16..23, big-endian u32) via POSIX od; no ImageMagick/`file` dependency.
png_dims() { od -An -tx1 -j16 -N8 "$1" | tr -d ' \n' | sed -E 's/^(.{8})(.{8})$/\1 \2/'; }

check_visual_pngs() {
  local d="docs/screens" v="target/gallery-verify" fail=0 s f sz dims w h ref=""
  [[ $(ls "$d" | wc -l) -eq 20 ]] || { echo "want 20 files in $d, have $(ls "$d" | wc -l)"; fail=1; }
  for s in "${GALLERY_SCREENS[@]}"; do
    f="$d/$s.png"
    [[ -f "$f" ]] || { echo "missing $f"; fail=1; continue; }
    sz=$(stat -c %s "$f" 2>/dev/null || stat -f %z "$f")
    [[ "$sz" -gt 4096 ]] || { echo "too small $f ($sz bytes)"; fail=1; }
    [[ "$(od -An -tx1 -N8 "$f" | tr -d ' \n')" == "89504e470d0a1a0a" ]] || { echo "not a PNG $f"; fail=1; continue; }
    dims="$(png_dims "$f")"; w=$((16#${dims%% *})); h=$((16#${dims##* }))
    # 100x30 cell grid: width and height must be exact multiples of the cell size and identical across screens.
    [[ $w -gt 0 && $h -gt 0 && $((w % 100)) -eq 0 && $((h % 30)) -eq 0 ]] || { echo "bad dims $f: ${w}x${h}"; fail=1; }
    [[ -z "$ref" ]] && ref="${w}x${h}"
    [[ "${w}x${h}" == "$ref" ]] || { echo "dims differ $f: ${w}x${h} vs $ref"; fail=1; }
    # committed SVG must be byte-identical to the SVG produced by the gate's own gallery run (determinism).
    [[ -f "$d/$s.svg" ]] || { echo "missing $d/$s.svg"; fail=1; continue; }
    cmp -s "$d/$s.svg" "$v/$s.svg" || { echo "svg differs from fresh gallery run: $s"; fail=1; }
    [[ -f "$v/$s.png" ]] || { echo "gallery run did not write $v/$s.png"; fail=1; }
  done
  return $fail
}
check_no_snap_new() { ! find crates -name '*.snap.new' -print | grep -q .; }
