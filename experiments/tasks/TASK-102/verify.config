# TASK-102 verify.config — sourced by verify.sh; data + check_* functions only.
BASE_REF="baseline"

FOCUSED_CMDS=(
  "cargo test -p pgtui --test app_create_form_test"
  "cargo test -p pgtui --test runtime_create_test"
  "INSTA_UPDATE=no INSTA_FORCE_PASS=0 cargo test -p pgtui --test screen_create_form_test"
)
# Explicit target list: TASK-101 + TASK-102 trusted tests; later files do not compile yet.
REGRESSION_CMDS=(
  "INSTA_UPDATE=no INSTA_FORCE_PASS=0 cargo test -p pgtui --lib --bins --test store_test --test screen_connection_list_test --test app_connection_list_test --test cli_test --test app_create_form_test --test runtime_create_test --test screen_create_form_test"
)
LINT_CMDS=("cargo fmt --all --check" "cargo clippy --workspace --all-targets -- -D warnings")

# "ERE|path1 path2". The regex part must not contain '|' (verify.sh splits on the first one).
FORBIDDEN_PATTERNS=(
  '#\[ignore\] @@ crates/pgtui'
  'todo!\( @@ crates/pgtui/src'
  'unimplemented!\( @@ crates/pgtui/src'
  'dbg!\( @@ crates/pgtui/src'
  'allow\((clippy|dead_code|unused) @@ crates/pgtui/src'
  'INSTA_ @@ crates/pgtui/src'
  '\.snap\.new @@ crates/pgtui/src'
  'TODO\(TASK-102\)'
  'tokio_postgres @@ crates/pgtui/src'
)
FORBIDDEN_PATHS=("crates/pgtui/src/db/postgres.rs")
REQUIRED_PATHS=("crates/pgtui/src/ui/create_form.rs")

ALLOWED_GLOBS=(
  "crates/pgtui/src/app.rs" "crates/pgtui/src/keys.rs" "crates/pgtui/src/runtime.rs"
  "crates/pgtui/src/ui/create_form.rs" "crates/pgtui/src/ui/mod.rs"
)
DENIED_GLOBS=(
  "Cargo.toml" "Cargo.lock" "crates/pgtui/Cargo.toml" "justfile" "rust-toolchain.toml" "rustfmt.toml"
  "crates/pgtui/tests/*" "crates/pgtui/src/render.rs" "crates/pgtui/src/fonts/*" "crates/pgtui/src/store/*"
  ".cargo/*" ".config/*" ".claude/*" "CLAUDE.md" "AGENTS.md"
)

EXTRA_CHECKS=("no_snap_new")
check_no_snap_new() {
  local hit; hit="$(find crates -name '*.snap.new' -print -quit)"
  [[ -z "$hit" ]] || { echo "pending snapshot: $hit"; return 1; }
  echo "ok no *.snap.new"
}
