# TASK-101 verify.config — sourced by verify.sh; data + check_* functions only.
BASE_REF="baseline"

# One command per trusted test file so a compile failure in one cannot mask another.
FOCUSED_CMDS=(
  "cargo test -p pgtui --test store_test"
  "INSTA_UPDATE=no INSTA_FORCE_PASS=0 cargo test -p pgtui --test screen_connection_list_test"
  "cargo test -p pgtui --test app_connection_list_test"
  "cargo test -p pgtui --test cli_test"
)
# Explicit target list: test files for later tasks exist in tests/ but do not compile yet.
REGRESSION_CMDS=(
  "INSTA_UPDATE=no INSTA_FORCE_PASS=0 cargo test -p pgtui --lib --bins --test store_test --test screen_connection_list_test --test app_connection_list_test --test cli_test"
)
LINT_CMDS=("cargo fmt --all --check" "cargo clippy --workspace --all-targets -- -D warnings")

# "ERE @@ path1 path2" — regex must NOT match in the given paths (default: whole tree). Regex may contain '|'.
FORBIDDEN_PATTERNS=(
  '#\[ignore\] @@ crates/pgtui'
  'todo!\( @@ crates/pgtui/src'
  'unimplemented!\( @@ crates/pgtui/src'
  'dbg!\( @@ crates/pgtui/src'
  'allow\((clippy|dead_code|unused) @@ crates/pgtui/src'
  'INSTA_ @@ crates/pgtui/src'
  '\.snap\.new @@ crates/pgtui/src'
  'TODO\(TASK-101\)'
  'tokio_postgres @@ crates/pgtui/src'
)
FORBIDDEN_PATHS=("crates/pgtui/src/db/postgres.rs")
REQUIRED_PATHS=(
  "crates/pgtui/src/store/mod.rs"
  "crates/pgtui/src/app.rs"
  "crates/pgtui/src/keys.rs"
  "crates/pgtui/src/runtime.rs"
  "crates/pgtui/src/ui/mod.rs"
  "crates/pgtui/src/ui/connection_list.rs"
  "crates/pgtui/src/ui/status.rs"
)

ALLOWED_GLOBS=("crates/pgtui/src/*")
DENIED_GLOBS=(
  "Cargo.toml" "Cargo.lock" "crates/pgtui/Cargo.toml" "justfile" "rust-toolchain.toml" "rustfmt.toml"
  "crates/pgtui/tests/*" "crates/pgtui/src/render.rs" "crates/pgtui/src/fonts/*"
  ".cargo/*" ".config/*" ".claude/*" "CLAUDE.md" "AGENTS.md"
)

EXTRA_CHECKS=("no_snap_new")
check_no_snap_new() {
  local hit; hit="$(find crates -name '*.snap.new' -print -quit)"
  [[ -z "$hit" ]] || { echo "pending snapshot: $hit"; return 1; }
  echo "ok no *.snap.new"
}
